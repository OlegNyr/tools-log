    <artifactId>tools-log-api</artifactId>

    <name>tools-log-api</name>
    <description>tools-log API: secret matcher to extend log masking with own secret classes, request-scoped
        registry of secrets to mask, scanner contract; no dependencies beyond the JDK</description>

    <properties>
        <module.name>io.github.olegnyr.toolslog.api</module.name>
        <toolslog.spring-allowed>false</toolslog.spring-allowed>
    </properties>

    <!-- То, что видит код сервиса: SecretMatcher для своих классов секретов, реестр секретов
         запроса и контракт сканера. Без зависимостей, кроме JDK: сервис, который только расширяет
         маскирование, тянет один этот jar. Реализации — tools-log-core. -->
</project>
